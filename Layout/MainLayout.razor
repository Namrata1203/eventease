@inherits LayoutComponentBase

<div class="min-h-screen bg-[#0f172a] text-slate-50 flex flex-col font-sans selection:bg-indigo-500/30 selection:text-indigo-200">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-[#0B1120]/80 backdrop-blur-xl border-b border-white/10 shadow-2xl">
        <div class="max-w-7xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="bg-gradient-to-br from-indigo-500 to-purple-500 w-8 h-8 rounded-lg flex items-center justify-center shadow-lg shadow-indigo-500/20">
                    <span class="text-white font-bold text-lg leading-none">E</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-lg tracking-tight text-white leading-none">EventEase</span>
                    <span class="text-[10px] font-mono text-indigo-400 font-medium tracking-widest uppercase">Copilot Validation</span>
                </div>
            </div>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center gap-1 bg-white/5 p-1 rounded-lg border border-white/5">
                <a href="/" class="px-4 py-1.5 rounded-md text-sm font-medium transition-all duration-200 hover:bg-white/10 hover:text-white text-slate-400">Dashboard</a>
                <a href="/attendance" class="px-4 py-1.5 rounded-md text-sm font-medium transition-all duration-200 hover:bg-white/10 hover:text-white text-slate-400">Attendance</a>
                <a href="/copilot" class="px-4 py-1.5 rounded-md text-sm font-medium transition-all duration-200 hover:bg-white/10 hover:text-white text-slate-400">Copilot Logs</a>
            </nav>

            <div class="hidden md:flex items-center gap-3">
                <div class="text-right">
                    <p class="text-xs font-medium text-slate-300">Admin Session</p>
                    <p class="text-[10px] text-slate-500 font-mono">admin@eventease.com</p>
                </div>
                <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center">
                    <span class="text-xs">👤</span>
                </div>
            </div>
            
            <!-- Mobile Menu Dropdown (Simplified) -->
            <div class="md:hidden">
                <select class="bg-slate-900 border border-slate-700 text-white text-sm rounded focus:ring-indigo-500 focus:border-indigo-500 block w-full p-2" onchange="window.location.href=this.value">
                    <option value="/">Dashboard</option>
                    <option value="/attendance">Attendance</option>
                    <option value="/copilot">Copilot Logs</option>
                </select>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 md:px-8 py-8 relative">
        @Body
    </main>
</div>
