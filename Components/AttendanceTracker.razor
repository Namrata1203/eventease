@using eventease.Models

<div class="bg-white/5 rounded-2xl p-6 md:p-8 border border-white/10 shadow-2xl backdrop-blur-md">
    <div class="flex flex-col md:flex-row justify-between md:items-end gap-6 mb-8 border-b border-white/10 pb-6">
        <div>
            <h2 class="text-2xl font-bold text-white tracking-tight mb-2">Attendance Terminal</h2>
            <p class="text-slate-400 text-sm max-w-xl">Live synchronized check-in gateway. Filter by name, ticket class, or scan email to verify attendees instantly.</p>
        </div>
        
        <!-- Stats -->
        <div class="flex gap-4">
            <div class="bg-slate-900/50 rounded-xl p-4 border border-white/5 min-w-[120px]">
                <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-1">Total Reg</p>
                <p class="text-2xl font-bold text-white">@Attendees.Count</p>
            </div>
            <div class="bg-indigo-500/10 rounded-xl p-4 border border-indigo-500/20 min-w-[120px]">
                <p class="text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-1">Checked In</p>
                <div class="flex items-baseline gap-2">
                    <p class="text-2xl font-bold text-indigo-400">@CheckedInCount</p>
                    <p class="text-sm font-medium text-indigo-300/60">@AttendancePercentage%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search/Filter -->
    <div class="relative mb-6">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-400">🔍</span>
        </div>
        <input @bind="SearchQuery" @bind:event="oninput" type="text" class="block w-full pl-10 pr-3 py-3 border border-white/10 rounded-xl leading-5 bg-slate-900/50 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 sm:text-sm transition-all shadow-inner" placeholder="Search Full Name / Email / Ticket" />
    </div>

    <!-- Attendee List -->
    <div class="space-y-3">
        @if (!FilteredAttendees.Any())
        {
            <div class="text-center py-12 bg-slate-900/30 rounded-xl border border-white/5 border-dashed">
                <span class="text-4xl mb-3 block">📭</span>
                <p class="text-slate-400 text-sm font-medium">No attendees match your active filters.</p>
            </div>
        }
        else
        {
            @foreach (var attendee in FilteredAttendees)
            {
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 bg-white/5 hover:bg-white/10 border border-white/5 hover:border-white/10 rounded-xl transition-all gap-4">
                    <div class="flex items-center gap-4">
                        <!-- Avatar placeholder -->
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold shadow-lg">
                            @attendee.Name.Substring(0, 1).ToUpper()
                        </div>
                        
                        <div>
                            <div class="flex items-center gap-2 mb-0.5">
                                <h4 class="font-bold text-white text-base">@attendee.Name</h4>
                                @if (attendee.TicketType == "VIP")
                                {
                                    <span class="bg-amber-500/20 text-amber-300 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider border border-amber-500/30">VIP</span>
                                }
                                else if (attendee.TicketType == "Speaker")
                                {
                                    <span class="bg-purple-500/20 text-purple-300 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider border border-purple-500/30">Speaker</span>
                                }
                            </div>
                            <p class="text-xs text-slate-400 font-mono">@attendee.Email</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end">
                        <div class="text-xs text-slate-500 font-medium">
                            @if (attendee.CheckedIn)
                            {
                                <span>In: @(DateTime.TryParse(attendee.CheckedInAt, out var dt) ? dt.ToString("HH:mm") : "")</span>
                            }
                        </div>
                        
                        <button @onclick="() => ToggleCheckIn(attendee)" 
                                class="relative inline-flex items-center justify-center w-32 h-9 rounded-lg font-bold text-sm transition-all duration-300 overflow-hidden group 
                                       @(attendee.CheckedIn ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/20" : "bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 hover:text-white")">
                            @if (attendee.CheckedIn)
                            {
                                <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Admitted</span>
                            }
                            else
                            {
                                <span>Check In</span>
                            }
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<Attendee> Attendees { get; set; } = new();

    public string SearchQuery { get; set; } = "";

    private IEnumerable<Attendee> FilteredAttendees =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? Attendees
            : Attendees.Where(a => 
                a.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || 
                a.Email.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || 
                a.TicketType.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

    private int CheckedInCount => Attendees.Count(a => a.CheckedIn);
    
    private int AttendancePercentage => Attendees.Count == 0 ? 0 : (int)Math.Round((double)CheckedInCount / Attendees.Count * 100);

    private void ToggleCheckIn(Attendee attendee)
    {
        attendee.CheckedIn = !attendee.CheckedIn;
        if (attendee.CheckedIn)
        {
            attendee.CheckedInAt = DateTime.UtcNow.ToString("o");
        }
        else
        {
            attendee.CheckedInAt = null;
        }
    }
}
