@using eventease.Models

<div class="bg-white/5 rounded-2xl border border-white/10 overflow-hidden hover:border-indigo-500/50 transition-all duration-300 shadow-xl group">
    <!-- Image Header -->
    <div class="h-48 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-[#0f172a] via-[#0f172a]/20 to-transparent z-10"></div>
        <img src="@EventData.ImageUrl" alt="@EventData.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute top-4 right-4 z-20">
            <span class="bg-indigo-500/80 backdrop-blur-md text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg">
                @EventData.Category
            </span>
        </div>
    </div>

    <!-- Content Body -->
    <div class="p-6">
        @if (IsEditing)
        {
            <div class="space-y-4 mb-4">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Title</label>
                    <input @bind="EventData.Title" @bind:event="oninput" class="w-full bg-slate-900/50 border border-slate-700 rounded p-2 text-white" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Capacity</label>
                    <input type="number" @bind="EventData.Capacity" @bind:event="oninput" class="w-full bg-slate-900/50 border border-slate-700 rounded p-2 text-white" />
                </div>
                <button @onclick="() => IsEditing = false" class="bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded text-sm w-full font-medium">Save Changes</button>
            </div>
        }
        else
        {
            <div class="flex justify-between items-start mb-2">
                <h3 class="text-xl font-bold text-white leading-tight">@EventData.Title</h3>
                <button @onclick="() => IsEditing = true" class="text-slate-400 hover:text-indigo-400 text-sm p-1">Edit</button>
            </div>
        }

        <!-- Details -->
        <div class="space-y-3 mb-6 mt-4">
            <div class="flex items-center text-slate-300 text-sm gap-3">
                <span class="bg-white/5 p-1.5 rounded text-indigo-400">📅</span>
                <span>@EventData.Date • @EventData.Time</span>
            </div>
            <div class="flex items-start text-slate-300 text-sm gap-3">
                <span class="bg-white/5 p-1.5 rounded text-rose-400 mt-0.5">📍</span>
                <span class="leading-relaxed">@EventData.Location</span>
            </div>
            <div class="flex items-center text-slate-300 text-sm gap-3">
                <span class="bg-white/5 p-1.5 rounded text-emerald-400">🏢</span>
                <span>@EventData.Organizer</span>
            </div>
        </div>

        <p class="text-slate-400 text-sm leading-relaxed mb-6 line-clamp-3">@EventData.Description</p>

        <!-- Availability Bar -->
        @{
            double percentage = EventData.Capacity > 0 ? ((double)EventData.RegisteredCount / EventData.Capacity) * 100 : 0;
            string barColor = percentage > 90 ? "bg-rose-500" : (percentage > 70 ? "bg-amber-500" : "bg-emerald-500");
        }
        <div class="space-y-2 pt-4 border-t border-white/5">
            <div class="flex justify-between text-xs font-medium">
                <span class="text-slate-400">Availability</span>
                <span class="text-white">@EventData.RegisteredCount / @EventData.Capacity</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
                <div class="@barColor h-2 rounded-full transition-all duration-500" style="width: @Math.Min(100, percentage)%"></div>
            </div>
            @if (percentage >= 100)
            {
                <p class="text-rose-400 text-xs font-semibold mt-1">Sold Out</p>
            }
        </div>
        
        @if (ShowRegisterButton)
        {
            <div class="mt-6">
                <button @onclick="OnRegisterClick" disabled="@(EventData.RegisteredCount >= EventData.Capacity)" class="w-full py-3 rounded-xl font-bold transition-all shadow-lg @((EventData.RegisteredCount >= EventData.Capacity) ? "bg-slate-800 text-slate-500 cursor-not-allowed shadow-none" : "bg-gradient-to-r from-indigo-500 to-purple-500 hover:from-indigo-400 hover:to-purple-400 text-white hover:shadow-indigo-500/25")">
                    @((EventData.RegisteredCount >= EventData.Capacity) ? "Waitlist Only" : "Register Now")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Event EventData { get; set; } = default!;

    [Parameter]
    public bool ShowRegisterButton { get; set; } = false;

    [Parameter]
    public EventCallback<string> OnRegister { get; set; }

    private bool IsEditing { get; set; } = false;

    private async Task OnRegisterClick()
    {
        if (OnRegister.HasDelegate)
        {
            await OnRegister.InvokeAsync(EventData.Id);
        }
    }
}
